<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <title>Blog Page</title>
</head>
<body>
    <%- include('./partials/nav') %>
    <div class="container mt-4">
        <h1><%= blog.title %></h1>
        <h5><%= blog.category %></h5>
        <img src="<%= blog.coverImageURL %>" alt="" width="800px">
        <pre class="mt-3 text-break" style="white-space: pre-wrap;"><%= blog.body %></pre>
    </div>
    <div class="container mt-4 mb-5">
        <img src="<%= blog.createdBy.profileImageURL %>" alt="Profile image" width="50px">
        <%= blog.createdBy.fullName %>
    </div>
    <div class="container mt-3"><% if (locals.user) { %>
         <form id="reportForm" action="/report/<%= blog._id %>" method="post">
            <div class="mb-3">
                <textarea name="content" class="form-control" placeholder="Add comment" id="floatingTextarea2" style="height: 100px" required></textarea>
            </div>
            <button class="btn btn-danger" type="submit">Report</button>
        </form>
        <div id="reportMessage"></div>
        <% } %></div>
    <div class="container mt-3">
        <h1>Comments(<%= comments.length %>)</h1>
        <% if (locals.user) { %>
         <form action="/blog/comment/<%= blog._id %>" method="post">
            <div class="mb-3">
                <textarea name="content" class="form-control" placeholder="Add comment" id="floatingTextarea2" style="height: 100px"></textarea>
            </div>
            <button class="btn btn-primary" type="submit">Post</button>
        </form>
        <% } %>
        
    </div>
    <div class="container mt-3">
        <% comments.forEach(comment => { %>
         <div>
            <img src="<%= comment.createdBy.profileImageURL %>" alt="Profile image" width="30px">
            <%= comment.createdBy.fullName %>
            <pre class="mt-1 mb-2"><%= comment.content %></pre>
         </div>
        <% }) %>
    </div>
    <%- include('./partials/scripts') %>
    <script>
        const form = document.querySelector("#reportForm");

        form.addEventListener("submit", async (e) => {
            e.preventDefault();

            const response = await fetch(form.action, {
                method: "POST",
                body: new FormData(form)
            });

            const data = await response.json();

            if (data.success) {
                document.querySelector("#reportMessage").textContent =data.message;
            }
});
    </script>
</body>
</html>