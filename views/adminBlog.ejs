<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <title>Blog Page</title>
</head>
<body>
    <%- include('./partials/nav') %>
    <div class="container mt-4">
        <h1><%= blog.title %></h1>
        <h5><%= blog.category %></h5>
        <img src="<%= blog.coverImageURL %>" alt="" width="800px">
        <pre class="mt-3 text-break" style="white-space: pre-wrap;"><%= blog.body %></pre>
    </div>
    <div class="container mt-4 mb-5">
        <img src="<%= blog.createdBy.profileImageURL %>" alt="Profile image" width="50px">
        <%= blog.createdBy.fullName %>
    </div>
    <h4>Reports(<%= reports.length %>)</h4>
    <div class="container mt-3">
        <% reports.forEach(report => { %>
         <div>
            <img src="<%= report. reportedBy.profileImageURL %>" alt="Profile image" width="30px">
            <%= report. reportedBy.fullName %>
            <pre class="mt-1 mb-2"><%= report.subject %></pre>
         </div>
         <a class="btn btn-primary" onclick="deleteBlog(event, '<%=report._id %>')">Delete</a>
        <% }) %>
    </div>
    <script>
async function deleteBlog(event, id) {
    event.preventDefault();

    const response = await fetch(`/report/${id}`, {
        method: "DELETE"
    });

        if (response.ok) {
        window.location.reload();
    }
}
</script>
    <%- include('./partials/scripts') %>
</body>
</html>