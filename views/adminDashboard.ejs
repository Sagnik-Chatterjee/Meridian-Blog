<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <title>Admin Dashboard</title>
    <style> body { background-color: #f5f6fa; } .dashboard-header { background-color: #212529; color: white; padding: 30px 0; } .stat-card { border: none; border-radius: 15px; transition: 0.2s; } .stat-card:hover { transform: translateY(-4px); } .stat-icon { width: 55px; height: 55px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 25px; } .action-card { border: none; border-radius: 15px; } .action-btn { padding: 15px; border-radius: 10px; font-weight: 500; } </style>
</head>
<body>
    <%- include('./partials/nav') %>
    <div class="dashboard-header"> 
        <div class="container"> 
            <h2 class="mb-1"> 
                <i class="bi bi-speedometer2 me-2"></i> Admin Dashboard 
            </h2> 
            <p class="mb-0 text-white-50"> Manage your blog platform </p> 
        </div> 
    </div>
    <div class="container py-5">
        <div class="row g-4 mb-5">
            <div class="col-md-6"> 
                <div class="card stat-card shadow-sm"> 
                    <div class="card-body p-4"> 
                        <div class="d-flex align-items-center"> 
                            <div class="stat-icon bg-primary bg-opacity-10 text-primary me-3"> 
                                <i class="bi bi-people-fill"></i> </div> <div> <p class="text-muted mb-1"> Total Users </p>
                                    <h2 class="mb-0"> <%= userCount %> </h2> 
                                </div> 
                            </div> 
                        </div> 
                    </div> 
                </div>
                <div class="col-md-6"> 
                    <div class="card stat-card shadow-sm"> 
                        <div class="card-body p-4"> 
                            <div class="d-flex align-items-center"> 
                                <div class="stat-icon bg-success bg-opacity-10 text-success me-3"> 
                                    <i class="bi bi-journal-text"></i> 
                                </div> 
                                <div> 
                                    <p class="text-muted mb-1"> Total Blogs </p>
                                    <h2 class="mb-0"> <%= blogCount %> </h2> 
                                </div> 
                            </div> 
                        </div> 
                    </div> 
                </div> 
            </div>
            <div class="card action-card shadow-sm"> 
                <div class="card-body p-4"> 
                    <h4 class="mb-4"> 
                        <i class="bi bi-gear me-2"></i> Admin Actions </h4> 
                        <div class="row g-3">
                            <div class="col-md-6"> 
                                <a href="/admin/users" class="btn btn-primary action-btn w-100" > 
                                    <i class="bi bi-people me-2"></i> View All Users </a> 
                                </div>
                                    <div class="col-md-6"> <a href="/admin/reported-blogs" class="btn btn-danger action-btn w-100" > 
                                        <i class="bi bi-flag me-2"></i> View Reported Blogs </a> 
                                    </div> 
                                </div> 
                            </div> 
                        </div> 
                    </div>
    <%- include('./partials/scripts') %>
</body>