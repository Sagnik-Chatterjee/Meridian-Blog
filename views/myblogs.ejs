<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <title>My Blogs</title>
</head>
<body>
    <%- include('./partials/nav') %>
    <h3>My Blogs</h3>
    <div class="container mt-3">
        <div class="row row-cols-3">
        <% blogs.forEach(blog => { %>
         <div class="card col" style="width: 18rem;">
            <img src="<%= blog.coverImageURL %>" class="card-img-top" alt="...">
            <div class="card-body">
                <p><%= blog.category%></p>
                <h5 class="card-title"><%= blog.title%></h5>
                <a href="/blog/editTitle/<%= blog._id %>" class="btn btn-primary">Edit Title</a>
                <a href="/blog/edit/<%= blog._id %>" class="btn btn-primary">Edit Blog</a>
                <a href="/blog/<%= blog._id %>" class="btn btn-primary">View</a>
            </div>
        </div>
        <% }) %>
        </div>
    </div>
    <%- include('./partials/scripts') %>
</body>
</html>