<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('./partials/head') %>
    <title>My Blogs</title>
</head>
<body>
    <%- include('./partials/nav') %>
    <h3>My Blogs</h3>
    <div class="container mt-3">
        <div class="row row-cols-3">
        <% blogs.forEach(blog => { %>
         <div class="card col" style="width: 18rem;">
            <img src="<%= blog.coverImageURL %>" class="card-img-top" alt="...">
            <div class="card-body">
                <p><%= blog.category%></p>
                <h5 class="card-title"><%= blog.title%></h5>
                <a href="/blog/editTitle/<%= blog._id %>" class="btn btn-primary">Edit Title</a>
                <a href="/blog/edit/<%= blog._id %>" class="btn btn-primary">Edit Blog</a>
                <a href="/blog/<%= blog._id %>" class="btn btn-primary">View</a>
                <a href="/blog/delete/<%= blog._id %>" onclick="deleteBlog(event, '<%=blog._id %>')" class="btn btn-primary">Delete</a>
            </div>
        </div>
        <% }) %>
        </div>
        <% if (blogs.length === 0) { %> 
                <div class="text-center py-5"> <i class="bi bi-check-circle text-success" style="font-size: 60px;" ></i> 
                    <h4 class="mt-3"> No Blogs Posted</h4> 
                    <p class="text-muted"> There are currently no blogs posted by you </p> 
                </div> 
                <% } %> 
    </div>
    <script>
async function deleteBlog(event, id) {
    event.preventDefault();

    const response = await fetch(`/blog/delete/${id}`, {
        method: "DELETE"
    });

    if (response.ok) {
        window.location.href = "/";
    }
}
</script>
    <%- include('./partials/scripts') %>
</body>
</html>